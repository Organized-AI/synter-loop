# Copy to .env (gitignored). Load per command: set -a; . ./.env; set +a
SYNTER_API_KEY=syn_...                          # synterai.com/developer
SYNTER_MCP_URL=https://mcp.syntermedia.ai/mcp/
JEV_GATEWAY_URL=https://...                     # your deployed jev-gateway
JEV_GATEWAY_TOKEN=...                           # jev-gateway auth
CAPTURE_ENDPOINT=https://agent-capture.example.workers.dev/v1/events
CAPTURE_TOKEN=...                               # bearer for the capture Worker
SGTM_ENDPOINT=https://example.stape.io           # optional sGTM endpoint
KERNEL_API_KEY=...                              # Tag Witness cloud browsers
CLOUDFLARE_API_TOKEN=...                        # Workers Scripts, R2 and D1 edit
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
HERMES_VERSION=v0.23.0
HERMES_LIVE_HOST=user@host.example                  # configure locally; do not commit the real address
OPENROUTER_API_KEY=...                          # optional: one live-model Hermes run
