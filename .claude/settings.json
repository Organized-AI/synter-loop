{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Team-shared settings. AGENTS.md is the rulebook; these permissions back it up. Personal overrides go in settings.local.json.",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(just:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(which:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(uv --version)",
      "Bash(ssh claw@100.82.244.127 hermes --version)",
      "Bash(ssh claw@100.82.244.127 hermes profile list)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(npm install:*)",
      "Bash(wrangler deploy:*)",
      "Bash(npx wrangler deploy:*)",
      "Bash(wrangler secret:*)",
      "Bash(wrangler d1:*)",
      "Bash(wrangler r2:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(ssh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(sudo:*)",
      "Bash(cat .env)",
      "Bash(curl:* | bash)",
      "Bash(wget:* | bash)",
      "Edit(.pi/mcp.json)",
      "Write(.pi/mcp.json)"
    ]
  }
}
