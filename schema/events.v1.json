{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organizedai.vip/synter-loop/schema/events.v1.json",
  "title": "Synter Loop event envelope v1",
  "type": "object",
  "required": ["event_id", "event_type", "schema_version", "timestamp", "run_id", "session_id", "turn_id", "harness_variant", "payload"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"enum": ["agent_session_start", "agent_turn_start", "agent_model_call", "agent_tool_call", "agent_subagent", "agent_gate_decision", "agent_approval", "agent_turn_complete", "agent_outcome"]},
    "schema_version": {"const": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 1},
    "session_id": {"type": ["string", "null"]},
    "turn_id": {"type": ["string", "null"]},
    "harness_variant": {
      "type": "object",
      "required": ["prompt_hash", "skill_versions", "model", "plugin_version", "jev_map_version", "holdout", "holdout_variant"],
      "properties": {
        "prompt_hash": {"type": "string"},
        "skill_versions": {"type": "object", "additionalProperties": {"type": "string"}},
        "model": {"type": "string"},
        "plugin_version": {"type": "string"},
        "jev_map_version": {"type": ["string", "null"]},
        "holdout": {"type": "boolean"},
        "holdout_variant": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"event_type": {"const": "agent_session_start"}}}, "then": {"properties": {"payload": {"required": ["capture_mode"]}}}},
    {"if": {"properties": {"event_type": {"const": "agent_turn_start"}}}, "then": {"properties": {"payload": {"required": ["message_hash"]}}}},
    {"if": {"properties": {"event_type": {"const": "agent_model_call"}}}, "then": {"properties": {"payload": {"required": ["model", "status", "latency_ms", "input_tokens", "output_tokens", "cached_tokens", "reasoning_tokens", "cost_usd"]}}}},
    {"if": {"properties": {"event_type": {"const": "agent_tool_call"}}}, "then": {"properties": {"payload": {"required": ["tool_name", "status", "latency_ms", "effect"]}}}},
    {"if": {"properties": {"event_type": {"const": "agent_subagent"}}}, "then": {"properties": {"payload": {"required": ["child_id", "status"]}}}},
    {"if": {"properties": {"event_type": {"const": "agent_gate_decision"}}}, "then": {"properties": {"payload": {"required": ["tool_name", "decision", "reasons"]}}}},
    {"if": {"properties": {"event_type": {"const": "agent_approval"}}}, "then": {"properties": {"payload": {"required": ["tool_name", "approved"]}}}},
    {"if": {"properties": {"event_type": {"const": "agent_turn_complete"}}}, "then": {"properties": {"payload": {"required": ["status", "total_tokens", "cost_usd", "latency_ms"]}}}},
    {"if": {"properties": {"event_type": {"const": "agent_outcome"}}}, "then": {"properties": {"payload": {"required": ["proposal_id", "grade", "source", "days_after"]}}}}
  ],
  "additionalProperties": false
}
